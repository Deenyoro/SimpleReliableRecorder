# Build + packaging artifacts (regenerated by build.py / PyInstaller)
build/
dist/
*.spec.bak
__pycache__/
*.py[cod]
*.egg-info/

# Bundled ffmpeg is staged at build time, never committed (large binary)
ffmpeg/
*.exe

# Runtime data, logs, recordings
_data/
data/
logs/
*.log
*.wav

# Local scratch / test files (single leading underscore, e.g. _t.py, _q.txt).
# The [!_] class deliberately excludes package files like __init__.py.
_[!_]*.py
_[!_]*.txt
_[!_]*.log
_[!_]*_out/
_probe*
_staged*
_check*
_verify*
_remote*

# Editor / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
